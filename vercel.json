{
  "functions": {
    "api/bolagsverket-import.py": {
      "maxDuration": 300,
      "includeFiles": "{scripts/*.py,data/bv-manifests/*.urls}"
    },
    "api/contact-import.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/bolagsverket-import?worker=1",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/bolagsverket-import?worker=2",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/bolagsverket-import?worker=3",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/contact-import",
      "schedule": "* * * * *"
    }
  ]
}

